{
  "expo": {
    "name": "Timelly - rezerwuj rozrywkę i usługi",
    "slug": "timelly-support",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usluginajuzowner.usluginajuzsupport"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.usluginajuzowner.usluginajuzsupport"
    },
    "web": {
      "name": "Timelly - rezerwuj rozrywkę i usługi",
      "shortName": "Timelly",
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "67f6dda5-92f4-4178-9435-fa1a56966509"
      }
    },
    "owner": "usluginajuz-owner",
    "updates": {
      "url": "https://u.expo.dev/67f6dda5-92f4-4178-9435-fa1a56966509"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
